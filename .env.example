# Server port (AI Studio uses 3000)
PORT=3000

# Optional: PostgreSQL / Supabase Session Pooler URI.
# When omitted or unreachable, Memory Vault automatically runs with its seeded in-memory database.
DATABASE_URL=

# Optional: Dedicated secret for signing stateless session & CSRF cookies across serverless instances.
SESSION_SECRET=

# Optional: Brevo Transactional Email API configuration.
# When omitted, notifications are recorded with status "logged_demo_fallback".
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
