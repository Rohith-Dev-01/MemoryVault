{
  "version": 2,
  "builds": [
    { "src": "server.ts", "use": "@vercel/node" },
    { "src": "MEMORY-VAULT/frontend/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.ts" },
    { "src": "^/$", "dest": "/MEMORY-VAULT/frontend/index.html" },
    { "src": "/MEMORY-VAULT/frontend/(.*)", "dest": "/MEMORY-VAULT/frontend/$1" },
    { "src": "/(.*)", "dest": "/MEMORY-VAULT/frontend/$1" }
  ]
}
