{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/",
      "destination": "/MEMORY-VAULT/frontend/index.html"
    },
    {
      "source": "/css/:path*",
      "destination": "/MEMORY-VAULT/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/MEMORY-VAULT/frontend/js/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/MEMORY-VAULT/frontend/assets/:path*"
    },
    {
      "source": "/:page.html",
      "destination": "/MEMORY-VAULT/frontend/:page.html"
    }
  ]
}
